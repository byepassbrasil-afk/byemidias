{
  "name": "byemidias",
  "description": "ByeMidias - Plataforma de Mídia Digital",
  "repository": "https://github.com/byepassbrasil-afk/byemidias",
  "keywords": ["nextjs", "react", "pocketbase", "digital-signage"],
  "build": {
    "provider": "nixpacks"
  },
  "env": {
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production"
    },
    "PORT": {
      "description": "Port to listen on",
      "value": "3000"
    },
    "NEXT_PUBLIC_APP_URL": {
      "description": "Public app URL (inlined at build time)"
    },
    "NEXT_PUBLIC_APP_NAME": {
      "description": "Public app name (inlined at build time)"
    },
    "NEXT_PUBLIC_SUPABASE_URL": {
      "description": "Supabase URL (inlined at build time)"
    },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "description": "Supabase anon key (inlined at build time)"
    },
    "PB_URL": {
      "description": "PocketBase URL"
    },
    "PB_ADMIN_EMAIL": {
      "description": "PocketBase admin email"
    },
    "PB_ADMIN_PASSWORD": {
      "description": "PocketBase admin password"
    },
    "AUTH_SECRET": {
      "description": "Auth secret"
    },
    "PARTNER_JWT_SECRET": {
      "description": "Partner JWT secret"
    }
  }
}
