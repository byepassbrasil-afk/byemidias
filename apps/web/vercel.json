    { "source": "/api/admin/crud/categories", "destination": "/api/pb/crud?table=categories" },
    { "source": "/api/dashboard/categories", "destination": "/api/pb/categories" },
    { "source": "/api/admin/categories/global", "destination": "/api/pb/categories" },
    { "source": "/api/admin/crud/partners", "destination": "/api/pb/crud?table=partner_access" },
    { "source": "/api/admin/crud/contract_templates", "destination": "/api/pb/crud?table=contract_templates" },
    { "source": "/api/admin/crud/partner_contracts", "destination": "/api/pb/crud?table=partner_contracts" },
    { "source": "/api/admin/crud/contract-templates", "destination": "/api/pb/crud?table=contract_templates" },
    { "source": "/api/admin/crud/partner-contracts", "destination": "/api/pb/crud?table=partner_contracts" },
    { "source": "/api/admin/crud/partner-payments", "destination": "/api/pb/crud?table=partner_payments" },
    { "source": "/api/admin/crud/partner_payments", "destination": "/api/pb/crud?table=partner_payments" },
    { "source": "/api/admin/crud/partner-contracts/:id/regenerate-pdf", "destination": "/api/pb/crud?table=partner_contracts" },
    { "source": "/api/admin/crud/partner-media", "destination": "/api/pb/crud?table=partner_media_uploads" },
    { "source": "/api/admin/crud/partner_media_uploads", "destination": "/api/pb/crud?table=partner_media_uploads" },
    { "source": "/api/admin/crud/advertisers", "destination": "/api/pb/crud?table=advertisers" },
    { "source": "/api/admin/crud/advertiser_devices", "destination": "/api/pb/crud?table=advertiser_devices" },
    { "source": "/api/admin/crud/advertiser_media", "destination": "/api/pb/crud?table=advertiser_media" },
    { "source": "/api/admin/crud/advertiser_invoices", "destination": "/api/pb/crud?table=advertiser_invoices" },
    { "source": "/api/admin/crud/expenses", "destination": "/api/pb/crud?table=expenses" },
