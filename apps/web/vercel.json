{
  "framework": "nextjs",
  "outputDirectory": ".next",
  "rewrites": [
    { "source": "/api/admin/crud/organizations", "destination": "/api/pb/crud?table=organizations" },
    { "source": "/api/admin/crud/devices", "destination": "/api/pb/crud?table=devices" },
    { "source": "/api/admin/crud/media", "destination": "/api/pb/crud?table=media" },
    { "source": "/api/admin/crud/playlists", "destination": "/api/pb/crud?table=playlists" },
    { "source": "/api/admin/crud/campaigns", "destination": "/api/pb/crud?table=campaigns" },
    { "source": "/api/admin/crud/units", "destination": "/api/pb/crud?table=units" },
    { "source": "/api/admin/crud/playlists/pending", "destination": "/api/pb/crud?table=playlists" },
    { "source": "/api/admin/crud/users", "destination": "/api/pb/crud?table=profiles" },
    { "source": "/api/admin/crud/profiles", "destination": "/api/pb/crud?table=profiles" },
    { "source": "/api/admin/crud/playlist_items", "destination": "/api/pb/crud?table=playlist_items" },
    { "source": "/api/admin/crud/campaign_playlists", "destination": "/api/pb/crud?table=campaign_playlists" },
    { "source": "/api/admin/crud/campaign_targets", "destination": "/api/pb/crud?table=campaign_targets" },
    { "source": "/api/admin/crud/partner_access", "destination": "/api/pb/crud?table=partner_access" },
    { "source": "/api/admin/crud/partner_devices", "destination": "/api/pb/crud?table=partner_devices" },
    { "source": "/api/admin/crud/device_logs", "destination": "/api/pb/crud?table=device_logs" },
    { "source": "/api/admin/crud/device_uptime_sessions", "destination": "/api/pb/crud?table=device_uptime_sessions" },
    { "source": "/api/admin/crud/activation_codes", "destination": "/api/pb/crud?table=activation_codes" },
    { "source": "/api/admin/crud/playlist_slots", "destination": "/api/pb/crud?table=playlist_slots" },
    { "source": "/api/admin/crud/device_groups", "destination": "/api/pb/crud?table=device_groups" },
    { "source": "/api/admin/crud/layout_templates", "destination": "/api/pb/crud?table=layout_templates" },
    { "source": "/api/admin/crud/playback_logs", "destination": "/api/pb/crud?table=playback_logs" },
    { "source": "/api/admin/crud/device_categories", "destination": "/api/pb/crud?table=device_categories" },
    { "source": "/api/admin/crud/media_categories", "destination": "/api/pb/crud?table=media_categories" },
    { "source": "/api/admin/crud/categories", "destination": "/api/pb/crud?table=categories" },
    { "source": "/api/dashboard/categories", "destination": "/api/pb/categories" },
    { "source": "/api/admin/categories/global", "destination": "/api/pb/categories" }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 0 */3 * *"
    },
    {
      "path": "/api/cron/cleanup-files",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/contract-expiry",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-uptime",
      "schedule": "0 4 * * *"
    }
  ]
}
