    { "source": "/api/admin/crud/partner_devices", "destination": "/api/pb/crud?table=partner_devices" },
    { "source": "/api/admin/crud/device_logs", "destination": "/api/pb/crud?table=device_logs" },
    { "source": "/api/admin/crud/device_uptime_sessions", "destination": "/api/pb/crud?table=device_uptime_sessions" },
    { "source": "/api/admin/crud/activation_codes", "destination": "/api/pb/crud?table=activation_codes" },
    { "source": "/api/admin/crud/playlist_slots", "destination": "/api/pb/crud?table=playlist_slots" },
    { "source": "/api/admin/crud/device_groups", "destination": "/api/pb/crud?table=device_groups" },
    { "source": "/api/admin/crud/layout_templates", "destination": "/api/pb/crud?table=layout_templates" },
    { "source": "/api/admin/crud/playback_logs", "destination": "/api/pb/crud?table=playback_logs" },
