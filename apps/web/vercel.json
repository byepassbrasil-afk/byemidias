    { "source": "/api/admin/crud/device_group_members", "destination": "/api/pb/crud?table=device_group_members" },
    { "source": "/api/admin/crud/campaign_time_slots", "destination": "/api/pb/crud?table=campaign_time_slots" },
    { "source": "/api/admin/crud/campaign_calendar", "destination": "/api/pb/crud?table=campaign_calendar" },
    { "source": "/api/admin/crud/content_schedules", "destination": "/api/pb/crud?table=content_schedules" },
    { "source": "/api/admin/crud/keepalive_log", "destination": "/api/pb/crud?table=keepalive_log" },
    { "source": "/api/admin/crud/activation-codes", "destination": "/api/pb/crud?table=activation_codes" }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 0 */3 * *"
    },
    {
      "path": "/api/cron/cleanup-files",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/contract-expiry",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-uptime",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-logs",
      "schedule": "10 0 * * *"
    }
  ]
}
